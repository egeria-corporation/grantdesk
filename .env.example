# grantdesk configuration
#
# Copy to .env and edit. .env is gitignored and must never be committed.
# On Cloudflare Workers, everything marked SECRET below is set with
# `wrangler secret put NAME` (or through the Deploy to Cloudflare flow), not in
# this file and not in wrangler.jsonc.
#
# The only value you must set to run grantdesk is SESSION_SECRET.
# `npx grantdesk demo` needs nothing at all.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# SECRET. Signs session cookies and derives the token-hashing pepper.
# Generate with: openssl rand -base64 48
# Changing it logs everyone out and invalidates outstanding magic links.
# It does not invalidate API tokens, which are hashed independently.
SESSION_SECRET=

# The public origin grantdesk is served from, with scheme and no trailing
# slash. Used to build magic-link URLs, webhook callback URLs, and canonical
# links in the portfolio export. Getting this wrong makes login emails point
# at localhost.
#   local:      http://localhost:8787
#   hosted:     https://desk.opengrants.io
#   self-host:  https://grants.yourfirm.com
APP_URL=http://localhost:8787

# ---------------------------------------------------------------------------
# OpenGrants integration — optional, never required
# ---------------------------------------------------------------------------
#
# grantdesk is fully functional with this unset. Setting it adds a live
# enrichment layer: saved searches and alerts can create pipeline items,
# opportunity deadlines refresh against the live record, and enriched values
# are marked "— live from OpenGrants" in the interface. If the key is missing,
# expired, or the network fails, enrichment disappears silently and nothing
# else is affected.
#
# Keys come from the OpenGrants Developer Dashboard.
# API docs: https://ops.opengrants.io/api-docs

# SECRET.
OPENGRANTS_API_KEY=

# Base URL for the OpenGrants REST API. Change only if you are pointed at a
# staging environment.
OPENGRANTS_API_BASE=https://qnoicxojartltrownmal.supabase.co/functions/v1/

# SECRET. Shared signing secret for inbound OpenGrants webhooks. Required only
# if you enable webhook delivery in the OpenGrants dashboard. Deliveries are
# verified with HMAC-SHA256 over the raw request body; a delivery that fails
# verification is rejected with 401 and logged, never processed.
OPENGRANTS_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
#
# Two supported targets, one schema, one set of migrations.
#
# --- Cloudflare Workers + D1 ---
#
# D1 is bound to the Worker by wrangler.jsonc, not by an environment variable.
# There is no connection string to set here. The binding must be named DB:
#
#   "d1_databases": [
#     { "binding": "DB", "database_name": "grantdesk", "database_id": "<id>" }
#   ]
#
# The Deploy to Cloudflare button provisions this database and writes the id
# into your fork. Doing it by hand:
#
#   wrangler d1 create grantdesk          # prints the database_id
#   wrangler d1 migrations apply grantdesk --remote
#
# For local development Wrangler emulates D1 on disk under .wrangler/state.
# `pnpm db:migrate:local` applies migrations there.
#
# Never put a D1 database id in .env. It belongs in wrangler.jsonc, which is
# committed, and it is an identifier rather than a credential.
#
# --- Node / Docker Compose ---
#
# Path to the SQLite file, inside the container. The Compose file mounts
# ./data over /data, so the database survives container replacement and is
# backed up by copying one file. Ignored on the Workers target.
DATABASE_PATH=/data/grantdesk.db

# ---------------------------------------------------------------------------
# Object storage — optional
# ---------------------------------------------------------------------------
#
# Used only for attachments: the submitted PDF, the signed award letter, the
# report you filed. grantdesk stores a pointer and a checksum, not a document
# management system. Leave storage disabled and attachments become external
# links only, which is a perfectly reasonable way to run this.
#
# On Workers this is an R2 binding named BUCKET in wrangler.jsonc, again with
# nothing to set here.
#
# On Node, one of: "none", "fs", "s3".
STORAGE_DRIVER=none
STORAGE_FS_PATH=/data/attachments
# S3-compatible (MinIO, Backblaze B2, R2 over the S3 API). SECRETs.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
#
# Used for two things only: magic-link sign-in, and the deadline digest.
# grantdesk does not send email to funders, grantees, or anyone who is not a
# member of your workspace.
#
# Driver: "console" | "resend" | "smtp"
# "console" prints the message to the log instead of sending it, which is the
# right setting for local development and for a single-user deployment where
# you would rather read the sign-in link off the terminal than configure a
# mail provider.
EMAIL_DRIVER=console
EMAIL_FROM="grantdesk <no-reply@example.org>"

# SECRET. Required when EMAIL_DRIVER=resend.
RESEND_API_KEY=

# Required when EMAIL_DRIVER=smtp. Not available on the Workers target, which
# cannot open raw TCP connections; use resend there.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Behavior
# ---------------------------------------------------------------------------

# IANA timezone used to interpret and display deadline dates when an award
# does not specify its own. Compliance deadlines are dates, not instants, and
# this is what keeps a report due 2027-01-30 from displaying as 2027-01-29.
DEFAULT_TIMEZONE=America/Los_Angeles

# Comma-separated lead times, in days, at which an upcoming obligation is
# surfaced and included in a digest.
OBLIGATION_LEAD_DAYS=30,14,7,1

# Time of day, in DEFAULT_TIMEZONE, that the daily digest is assembled. On
# Workers the actual firing is a cron trigger in wrangler.jsonc; this controls
# which recipients are considered due for a digest at that firing.
DIGEST_HOUR=7

# How far ahead the recurrence engine materializes obligations from rules.
# Rules are expanded lazily out to this horizon and re-expanded on change, so
# a five-year award does not create sixty rows on day one.
OBLIGATION_HORIZON_DAYS=540

# Single-user mode for a self-hosted deployment with exactly one operator.
# When set, that address is treated as the workspace owner and sign-in still
# uses a magic link, so an exposed instance is not an open door. Leave blank
# for normal multi-user operation.
SINGLE_USER_EMAIL=

# Comma-separated email domains allowed to complete sign-in. Blank means any
# address that already has a membership may sign in, which is the correct
# default: grantdesk never creates an account from an unsolicited sign-in
# attempt, only from an invitation.
ALLOWED_EMAIL_DOMAINS=

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------

# "development" | "production". Production enables secure cookies, HSTS, and
# strict origin checking on form posts.
NODE_ENV=development

# Port for the Node target. Ignored on Workers.
PORT=8787

# "debug" | "info" | "warn" | "error". Logs never contain client record
# contents, only identifiers.
LOG_LEVEL=info
